#!/bin/sh
set -e

push_updates_file="$(mktemp "${TMPDIR:-/tmp}/tiangong-prepush-updates.XXXXXX")"
trap 'rm -f "$push_updates_file"' 0 1 2 15
cat >"$push_updates_file"

pinned_node_active() {
  command -v node >/dev/null 2>&1 &&
    node -e 'process.exit(process.versions.node === "24.19.0" ? 0 : 1)'
}

if ! pinned_node_active; then
  export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
  if [ -s "$NVM_DIR/nvm.sh" ]; then
    . "$NVM_DIR/nvm.sh"
    if ! nvm use 24.19.0 >/dev/null 2>&1; then
      :
    fi
  fi
fi

if ! pinned_node_active; then
  echo "Node.js 24.19.0 is required for the pre-push gate." >&2
  exit 1
fi

node scripts/prepush-gate-receipt.cjs hook-run \
  --remote-name "${1:-}" \
  --remote-url "${2:-}" \
  --docpact-base-override "${DOCPACT_BASE_REF:-}" \
  --updates-file "$push_updates_file"
